{
  "name": "opgg-mcp",
  "version": "1.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "test": "npx @modelcontextprotocol/inspector@latest node dist/index.js"
  },
  "bin": {
    "opgg-mcp": "dist/index.js"
  },
  "keywords": [
    "MCP",
    "SSE",
    "proxy"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "eventsource": "^5.1.3",
    "zod": "^4.6.7"
  },
  "repository": {
    "url": "https://github.com/opgginc/opgg-mcp"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "splitting": true,
    "sourcemap": true,
    "clean": true
  }
}
